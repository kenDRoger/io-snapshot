{
  "name": "@kendroger/io-snapshot",
  "version": "1.2.0",
  "description": "Capture and compare function behavior snapshots for zero-regression refactoring.",
  "keywords": [
    "refactor",
    "testing",
    "semantic",
    "automation",
    "ai",
    "diff",
    "test"
  ],
  "homepage": "https://github.com/kenDRoger/io-snapshot#readme",
  "bugs": {
    "url": "https://github.com/kenDRoger/io-snapshot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenDRoger/io-snapshot.git"
  },
  "license": "MIT",
  "author": "kendroger",
  "type": "module",
  "exports": {
    ".": "./lib/core/recorder.js",
    "./recorder": "./lib/core/recorder.js",
    "./verifier": "./lib/core/verifier.js",
    "./adapter": "./lib/adapter/index.js",
    "./daemon": "./lib/core/daemon.js",
    "./constants": "./lib/core/constants.js",
    "./config": "./lib/core/config.js",
    "./logger": "./lib/core/logger.js"
  },
  "main": "./lib/core/recorder.js",
  "bin": {
    "io-snapshot": "bin/cli.js"
  },
  "scripts": {
    "test": "vitest",
    "build:java": "cd io-snapshot-java && mvn package -DskipTests",
    "postinstall": "npm run build:java",
    "clean": "rm -rf io-snapshot-java/target"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "commander": "^12.0.0",
    "microdiff": "^1.5.0",
    "superjson": "^2.2.1",
    "tinyglobby": "^0.2.0",
    "ts-morph": "^21.0.0"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
