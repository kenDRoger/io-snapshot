{
  "name": "@kendroger/io-snapshot",
  "version": "1.2.0",
  "description": "Capture and compare function behavior snapshots for zero-regression refactoring.",
  "keywords": [
    "refactor",
    "testing",
    "semantic",
    "automation",
    "ai",
    "diff",
    "test"
  ],
  "homepage": "https://github.com/kenDRoger/io-snapshot#readme",
  "bugs": {
    "url": "https://github.com/kenDRoger/io-snapshot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenDRoger/io-snapshot.git"
  },
  "license": "MIT",
  "author": "kendroger",
  "type": "module",
  "exports": {
    ".": "./dist/core/recorder.js",
    "./recorder": "./dist/core/recorder.js",
    "./verifier": "./dist/core/verifier.js",
    "./transformer": "./dist/adapter/js/transformer.js",
    "./daemon": "./dist/core/daemon.js",
    "./constants": "./dist/core/constants.js",
    "./config": "./dist/core/config.js",
    "./logger": "./dist/core/logger.js"
  },
  "main": "./dist/core/recorder.js",
  "bin": {
    "io-snapshot": "./dist/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "build:java": "cd io-snapshot-java && mvn package -DskipTests",
    "clean": "rm -rf dist io-snapshot-java/target",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npx vitest run && npm run build"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "commander": "^12.0.0",
    "microdiff": "^1.5.0",
    "superjson": "^2.2.1",
    "tinyglobby": "^0.2.0",
    "ts-morph": "^21.0.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "types": "./dist/core/recorder.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  }
}
